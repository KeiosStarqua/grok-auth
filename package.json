{
  "name": "grok-auth",
  "version": "1.0.0",
  "description": "authstash: universal account switcher for AI coding-agent CLIs (Grok, Kiro, ...)",
  "type": "module",
  "bin": {
    "grok-auth": "dist/grok-auth.js",
    "authstash": "dist/authstash.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); for (const f of ['dist/grok-auth.js','dist/authstash.js']) fs.chmodSync(f, 0o755)\"",
    "prepublishOnly": "npm run build",
    "start": "node dist/grok-auth.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "authstash",
    "grok",
    "kiro",
    "xai",
    "cli",
    "auth",
    "oidc",
    "sso",
    "accounts",
    "profiles"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeiosStarqua/grok-auth.git"
  },
  "homepage": "https://github.com/KeiosStarqua/grok-auth#readme",
  "bugs": {
    "url": "https://github.com/KeiosStarqua/grok-auth/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
